{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChaoYuZhang001/dsh-gate/schema/matrix-config.schema.json",
  "title": "DSH Gate compatibility matrix config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "targets"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dshVersion", "platform"],
      "properties": {
        "dshVersion": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "packagePath": { "type": "string", "minLength": 1 },
          "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
