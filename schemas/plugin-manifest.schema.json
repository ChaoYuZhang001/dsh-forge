{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChaoYuZhang001/dsh-gate/schema/plugin-manifest.schema.json",
  "title": "DSH Gate plugin manifest",
  "description": "Optional dsh.gate metadata consumed by the DSH Gate alpha verifier.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "compatibleWith": { "type": "string", "minLength": 1 },
    "permissions": {
      "type": "array",
      "items": { "enum": ["filesystem", "shell", "network", "secrets", "subprocess", "native"] },
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requiresRestart": { "type": "boolean" },
    "nativeBinaries": { "type": "boolean" }
  },
  "additionalProperties": false
}
